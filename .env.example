# Environment: 'development', 'production', or 'test'
ENVIRONMENT=development

# PostgreSQL Connection String (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/releaseguard

# Redis Connection URL
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# In production, must be at least 32 characters long
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Payload Size Limits (bytes)
MAX_PAYLOAD_SIZE=1048576
MAX_BULK_PAYLOAD_SIZE=5242880

# Ingestion Limits
MAX_BULK_EVENTS=100

# Authentication Rate Limiting
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
